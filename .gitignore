# Playwright and test runner output
playwright-report/
**/playwright-report/
# Playwright OUTPUT dirs, anchored to the root — an unanchored "test-results/"
# would also swallow the dashboard SOURCE dir
# apps/dashboard/src/components/test-results/ (it did, once).
/test-results/
/test-reports/

# Generated exploratory tests
**/tests/generated/
**/e2e/generated/

# Stryker mutation testing
.stryker-tmp/
reports/

.local

# Local dependency store
.pnpm-store/

# Playground QA output (generated Playwright reports, not source)
/tools/playground-notes/test-reports/

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/
