{
    "name": "cli",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/cli/src",
    "projectType": "application",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/esbuild:esbuild",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "dependsOn": [
                "^build",
                {
                    "projects": ["dashboard"],
                    "target": "build"
                }
            ],
            "options": {
                "platform": "node",
                "outputPath": "dist/apps/cli",
                "main": "apps/cli/src/bin.ts",
                "tsConfig": "apps/cli/tsconfig.app.json",
                "bundle": true,
                "format": ["cjs"],
                "generatePackageJson": true,
                "additionalEntryPoints": ["apps/cli/src/index.ts"],
                "assets": [
                    {
                        "input": "dist/apps/dashboard",
                        "glob": "**/*",
                        "output": "public"
                    }
                ]
            },
            "configurations": {
                "development": {},
                "production": {}
            }
        },
        "install-deps": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/cli/node_modules"],
            "options": {
                "commands": [
                    "echo '📦 Installing CLI dependencies for development...'",
                    "cd dist/apps/cli && npm install --silent",
                    "echo '✅ Dependencies installed!'"
                ],
                "parallel": false
            }
        },
        "build:dev": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/cli"],
            "dependsOn": ["build"],
            "options": {
                "commands": [
                    "nx run cli:install-deps"
                ],
                "parallel": false
            }
        },
        "serve": {
            "executor": "@nx/js:node",
            "defaultConfiguration": "development",
            "dependsOn": ["build:dev"],
            "options": {
                "buildTarget": "cli:build",
                "args": ["start"]
            },
            "configurations": {
                "development": {
                    "buildTarget": "cli:build"
                },
                "production": {
                    "buildTarget": "cli:build"
                }
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm biome lint apps/cli"
            }
        }
    }
}
