{
    "name": "cli",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/cli/src",
    "projectType": "application",
    "tags": [],
    "targets": {
        "build:esbuild": {
            "executor": "@nx/esbuild:esbuild",
            "outputs": ["{options.outputPath}"],
            "defaultConfiguration": "production",
            "dependsOn": [
                "^build",
                {
                    "projects": ["dashboard"],
                    "target": "build"
                }
            ],
            "options": {
                "platform": "node",
                "outputPath": "dist/apps/cli",
                "main": "apps/cli/src/bin.ts",
                "tsConfig": "apps/cli/tsconfig.app.json",
                "bundle": true,
                "format": ["cjs"],
                "generatePackageJson": true,
                "additionalEntryPoints": ["apps/cli/src/index.ts"]
            },
            "configurations": {
                "development": {},
                "production": {}
            }
        },
        "copy-dashboard": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/cli/public"],
            "dependsOn": ["build:esbuild"],
            "options": {
                "commands": [
                    "mkdir -p dist/apps/cli/public",
                    "cp -r dist/apps/dashboard/* dist/apps/cli/public/",
                    "cp apps/cli/README.md dist/apps/cli/README.md"
                ],
                "parallel": false
            }
        },
        "install-deps": {
            "executor": "nx:run-commands",
            "cache": false,
            "dependsOn": ["copy-dashboard"],
            "options": {
                "commands": [
                    "echo '📦 Installing CLI dependencies into dist/apps/cli...'",
                    "cd dist/apps/cli && npm install --silent --legacy-peer-deps",
                    "echo '✅ Dependencies installed!'"
                ],
                "parallel": false
            }
        },
        "build": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/cli"],
            "dependsOn": ["install-deps"],
            "options": {
                "commands": ["echo '✅ CLI build complete with dashboard assets'"],
                "parallel": false
            }
        },
        "build:dev": {
            "executor": "nx:run-commands",
            "outputs": ["{workspaceRoot}/dist/apps/cli"],
            "dependsOn": ["build"],
            "options": {
                "commands": ["echo '✅ CLI dev build ready'"],
                "parallel": false
            }
        },
        "serve": {
            "executor": "nx:run-commands",
            "defaultConfiguration": "development",
            "dependsOn": ["build"],
            "options": {
                "command": "node dist/apps/cli/bin.cjs start"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm biome lint apps/cli"
            }
        },
        "test": {
            "executor": "@nx/vitest:test",
            "outputs": ["{workspaceRoot}/coverage/apps/cli"],
            "options": {
                "config": "apps/cli/vitest.config.ts"
            }
        }
    }
}
