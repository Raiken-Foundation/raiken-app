{
    "name": "dashboard",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "apps/dashboard/src",
    "projectType": "application",
    "tags": ["type:app", "scope:dashboard"],
    "// targets": "to see all targets run: nx show project dashboard --web",
    "targets": {
        "build": {
            "executor": "@nx/vite:build",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/apps/dashboard",
                "configFile": "apps/dashboard/vite.config.mts"
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm biome lint apps/dashboard"
            }
        },
        "test": {
            "executor": "@nx/vitest:test",
            "outputs": ["{workspaceRoot}/coverage/apps/dashboard"],
            "options": {
                "config": "apps/dashboard/vite.config.mts"
            }
        }
    }
}
