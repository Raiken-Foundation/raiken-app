{
    "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "files": {
        "includes": [
            "**",
            "!**/node_modules",
            "!**/dist",
            "!**/tmp",
            "!**/.nx",
            "!**/.raiken",
            "!**/coverage",
            "!**/test-results",
            "!**/playwright-report"
        ]
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    },
    "json": {
        "formatter": {}
    },
    "overrides": [
        {
            "includes": ["libs/core/**", "libs/shared/**"],
            "linter": {
                "rules": {
                    "complexity": {
                        "useLiteralKeys": "off"
                    }
                }
            }
        }
    ]
}
