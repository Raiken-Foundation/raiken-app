{
    "name": "core",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/core/src",
    "projectType": "library",
    "tags": ["type:lib", "scope:core"],
    "targets": {
        "build": {
            "executor": "@nx/esbuild:esbuild",
            "outputs": ["{options.outputPath}"],
            "options": {
                "outputPath": "dist/libs/core",
                "main": "libs/core/src/index.ts",
                "tsConfig": "libs/core/tsconfig.lib.json",
                "format": ["cjs"],
                "generatePackageJson": true
            }
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "command": "pnpm biome lint libs/core"
            }
        },
        "test": {
            "executor": "@nx/vitest:test",
            "outputs": ["{workspaceRoot}/coverage/libs/core"],
            "options": {
                "config": "libs/core/vitest.config.ts"
            }
        },
        "test:integration": {
            "executor": "@nx/vitest:test",
            "outputs": ["{workspaceRoot}/coverage/libs/core-integration"],
            "options": {
                "config": "libs/core/vitest.integration.config.ts"
            }
        }
    }
}
