{
    "name": "@raiken-monorepo/source",
    "version": "0.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "nx run-many -t serve -p cli dashboard",
        "lint": "biome lint .",
        "format": "biome format .",
        "check": "biome check .",
        "test": "nx run core:test && nx run shared:test && nx run cli:test && nx run dashboard:test",
        "test:integration": "nx run core:test:integration",
        "verify": "node scripts/verify-gates.mjs",
        "build": "nx run-many -t build",
        "typecheck": "nx run-many -t typecheck -p core,shared,cli,dashboard",
        "lint:boundaries": "eslint --config eslint.boundaries.config.mjs apps/cli apps/dashboard libs/core libs/shared --max-warnings=0",
        "cli:build": "nx build cli --skip-nx-cache",
        "cli:install": "node scripts/install-built-cli.mjs",
        "cli:deploy": "pnpm run cli:build && pnpm run cli:install && raiken --version",
        "smoke:cli": "node scripts/smoke-installed-cli.mjs"
    },
    "private": true,
    "packageManager": "pnpm@10.15.1",
    "engines": {
        "node": ">=22 <23",
        "pnpm": ">=10 <11"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.3.8",
        "@eslint/js": "^9.8.0",
        "@nx/esbuild": "^22.1.3",
        "@nx/eslint": "22.1.3",
        "@nx/eslint-plugin": "22.1.3",
        "@nx/js": "22.1.3",
        "@nx/node": "^22.1.3",
        "@nx/react": "^22.1.3",
        "@nx/vite": "^22.1.3",
        "@nx/vitest": "22.1.3",
        "@nx/web": "22.1.3",
        "@nx/workspace": "22.1.3",
        "@playwright/test": "^1.57.0",
        "@swc-node/register": "~1.9.1",
        "@swc/core": "~1.5.7",
        "@swc/helpers": "~0.5.11",
        "@testing-library/dom": "10.4.0",
        "@testing-library/react": "16.3.0",
        "@types/node": "^24.10.1",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.2.0",
        "@vitest/coverage-v8": "^4.0.0",
        "@vitest/ui": "^4.0.0",
        "esbuild": "^0.19.2",
        "eslint": "^9.8.0",
        "jiti": "2.4.2",
        "jsdom": "~22.1.0",
        "jsonc-eslint-parser": "^2.1.0",
        "nx": "22.1.3",
        "tslib": "^2.3.0",
        "typescript": "~5.9.2",
        "typescript-eslint": "^8.40.0",
        "vite": "^7.0.0",
        "vitest": "^4.0.0"
    },
    "dependencies": {
        "@monaco-editor/react": "^4.7.0",
        "playwright": "^1.57.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0",
        "sqlite-vec": "0.1.7-alpha.2"
    }
}
