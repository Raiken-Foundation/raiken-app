{
    "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
    "root": false,
    "files": {
        "includes": ["**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,json,jsonc}"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noDescendingSpecificity": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    }
}
