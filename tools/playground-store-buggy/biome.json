{
    "$schema": "https://biomejs.dev/schemas/2.3.8/schema.json",
    "root": false,
    "files": {
        "includes": ["src/**", "e2e/**", "tests/**", "auth-server.ts"]
    },
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true,
            "style": {
                "noDescendingSpecificity": "off"
            }
        }
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double"
        }
    }
}
