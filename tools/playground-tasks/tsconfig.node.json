{
    "compilerOptions": {
        "target": "ES2022",
        "skipLibCheck": true,
        "module": "ESNext",
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "allowSyntheticDefaultImports": true,
        "noEmit": true,
        "strict": true,
        "types": ["node"]
    },
    "include": ["vite.config.ts", "auth-server.ts"]
}
